/images/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# NOTE (round 49): /css/* and /js/* are served immutable for a year, which
# means a browser will NOT revalidate them -- not on reload, not on hard
# reload. Every reference in the HTML therefore carries a ?v=<content-hash>
# query string. After editing ANYTHING in /css or /js, run:
#
#     python3 tools/stamp-assets.py
#
# or returning visitors keep the old file. For rp-pricing-engine.js that
# means they keep being quoted the old prices.

# Round 49: repo-only files that the static host serves anyway. noindex so
# they stay out of search results; move them out of the deploy to really
# fix it.
/tools/*
  X-Robots-Tag: noindex
/workers/*
  X-Robots-Tag: noindex
/WEBHOOK-MAPPING-V28.txt
  X-Robots-Tag: noindex
